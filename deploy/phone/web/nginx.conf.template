# The Sprout web app on the phone: the same headers and /api forwarding as the web image's nginx
# (sprout-web/nginx/default.conf.template), for Termux's nginx. run.sh fills in @PREFIX@ and @HERE@.
daemon off;
worker_processes 2;
worker_rlimit_nofile 16384;
pid @HERE@/nginx.pid;
error_log stderr warn;

# 256 connections dropped requests above ~130 a second in the capacity test (2026-10-08); each request through
# here holds two (the visitor's and the gateway's), and price streams hold theirs for hours
events { worker_connections 4096; }

http {
    include @PREFIX@/etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    client_body_temp_path @HERE@/tmp/body;
    proxy_temp_path @HERE@/tmp/proxy;
    fastcgi_temp_path @HERE@/tmp/fastcgi;
    uwsgi_temp_path @HERE@/tmp/uwsgi;
    scgi_temp_path @HERE@/tmp/scgi;

    # cellwatch writes this (ADR-027): which of local, peer or standby serves each cell's customers
    include @CELLS@/routes.conf;

    # connections to the gateway are kept open and reused, instead of a new one for every request
    upstream gateway {
        server 127.0.0.1:8100;
        keepalive 64;
    }

    server {
        listen 127.0.0.1:8180;   # only the Cloudflare tunnel reaches it
        @CAPACITY_LISTEN@
        server_name _;
        root @HERE@/html;
        index index.html;

        server_tokens off;
        gzip on;
        gzip_types text/css application/javascript application/json image/svg+xml;
        gzip_min_length 1024;

        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

        location = /healthz {
            default_type text/plain;
            return 200 'ok';
        }

        # how the cells see each other, and how the web app picks a new customer's cell
        location = /cells/status.json {
            alias @CELLS@/status.json;
            default_type application/json;
            add_header Cache-Control "no-store" always;
        }
        location = /cells.json {
            alias @CELLS@/cells.json;
            default_type application/json;
            add_header Cache-Control "no-store" always;
        }

        location /api/ {
            error_page 418 = @peer;
            error_page 419 = @standby;
            if ($sprout_route = peer) { return 418; }
            if ($sprout_route = standby) { return 419; }
            add_header X-Sprout-Cell a always;
            proxy_pass http://gateway;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            # Cloudflare names the real visitor; the gateway trusts it only because nothing but the tunnel reaches this server
            proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
            proxy_set_header CF-Visitor $http_cf_visitor;
            proxy_set_header Authorization $http_authorization;
            # live prices are one response that stays open for hours
            proxy_buffering off;
            proxy_read_timeout 3600s;
            client_max_body_size 64k;
            add_header Cache-Control "no-store" always;
            add_header X-Content-Type-Options "nosniff" always;
        }

        # cell B's customer: to cell B, which answers with its own X-Sprout-Cell. The cells' key lets cell B believe
        # the client address this cell names (Cloudflare would name this cell)
        location @peer {
            resolver 1.1.1.1 1.0.0.1 valid=60s ipv6=off;
            set $peer https://sprout-b-saiworks.nncs.in;
            proxy_pass $peer;
            proxy_ssl_server_name on;
            proxy_ssl_name sprout-b-saiworks.nncs.in;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host sprout-b-saiworks.nncs.in;
            proxy_set_header X-Sprout-Cell $http_x_sprout_cell;
            proxy_set_header Authorization $http_authorization;
            proxy_set_header X-Cell-Key @CELL_KEY@;
            proxy_set_header X-Sprout-Client-IP $http_cf_connecting_ip;
            proxy_buffering off;
            proxy_read_timeout 3600s;
            client_max_body_size 64k;
        }

        # cell B's customer after a takeover: its services, running here on the copy of its database
        location @standby {
            proxy_pass http://127.0.0.1:8200;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
            proxy_set_header CF-Visitor $http_cf_visitor;
            proxy_set_header Authorization $http_authorization;
            proxy_buffering off;
            proxy_read_timeout 3600s;
            client_max_body_size 64k;
            add_header X-Sprout-Cell b always;
            add_header Cache-Control "no-store" always;
        }

        # built files have hashed names: cache for a year
        location ~* \.(?:js|css|woff2|svg|png|ico)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
            add_header X-Content-Type-Options "nosniff" always;
            try_files $uri =404;
        }

        # every other address is the app (it routes in the browser); index.html itself is never cached
        location / {
            add_header Cache-Control "no-cache";
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options "DENY" always;
            add_header Referrer-Policy "no-referrer" always;
            add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
            try_files $uri /index.html;
        }
    }
}
