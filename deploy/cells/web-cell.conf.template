# The laptop cell's web server (ADR-027): the web image's own configuration, plus where each cell's customers are
# served from. Mounted over the image's template; the image fills in ${...} from the environment at start.
#   SPROUT_API          this cell's gateway
#   SPROUT_CELL         this cell's id;  SPROUT_PEER the other cell's
#   SPROUT_PEER_HOST    the other cell's own public address (it serves its own customers there)
#   SPROUT_STANDBY_API  the standby's gateway (the other cell's services, run here only after a takeover)
#   CELL_KEY            the cells' shared key, sent with forwarded requests so the other cell believes the client address

# cellwatch.py writes this: which of local, peer or standby serves each cell's customers
include /etc/nginx/cells/routes.conf;

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Docker's DNS, so the gateway, the standby and the other cell are found when asked for, not at start
    resolver 127.0.0.11 valid=10s ipv6=off;

    server_tokens off;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # how the cells see each other, and how the web app picks a new customer's cell
    location = /cells/status.json {
        alias /etc/nginx/cells/status.json;
        default_type application/json;
        add_header Cache-Control "no-store" always;
    }
    location = /cells.json {
        alias /etc/nginx/cells/cells.json;
        default_type application/json;
        add_header Cache-Control "no-store" always;
    }

    location /api/ {
        error_page 418 = @peer;
        error_page 419 = @standby;
        if ($sprout_route = peer) { return 418; }
        if ($sprout_route = standby) { return 419; }

        set $gateway ${SPROUT_API};
        proxy_pass $gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Cloudflare names the real visitor; the gateway trusts it only because nothing but the tunnel reaches this server
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_set_header CF-Visitor $http_cf_visitor;
        proxy_set_header Authorization $http_authorization;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        client_max_body_size 64k;
        add_header X-Sprout-Cell ${SPROUT_CELL} always;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    # the other cell's customer: to the other cell, which answers with its own X-Sprout-Cell
    location @peer {
        set $peer https://${SPROUT_PEER_HOST};
        proxy_pass $peer;
        proxy_ssl_server_name on;
        proxy_ssl_name ${SPROUT_PEER_HOST};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host ${SPROUT_PEER_HOST};
        proxy_set_header X-Sprout-Cell $http_x_sprout_cell;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Cell-Key ${CELL_KEY};
        proxy_set_header X-Sprout-Client-IP $http_cf_connecting_ip;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        client_max_body_size 64k;
    }

    # the other cell's customer after a takeover: its services, running here on the copy of its database
    location @standby {
        set $standby ${SPROUT_STANDBY_API};
        proxy_pass $standby;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
        proxy_set_header CF-Visitor $http_cf_visitor;
        proxy_set_header Authorization $http_authorization;
        proxy_buffering off;
        proxy_read_timeout 3600s;
        client_max_body_size 64k;
        add_header X-Sprout-Cell ${SPROUT_PEER} always;
        add_header Cache-Control "no-store" always;
    }

    # built files have hashed names: cache for a year
    location ~* \.(?:js|css|woff2|svg|png|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # every other address is the app (it routes in the browser); index.html itself is never cached
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        try_files $uri /index.html;
    }
}
