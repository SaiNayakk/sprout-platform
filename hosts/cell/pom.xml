<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.12</version>
    <relativePath/>
  </parent>

  <groupId>app.sprout.hosts</groupId>
  <artifactId>cell-host</artifactId>
  <version>0.1.0</version>
  <name>cell-host</name>
  <description>Every Sprout service in one JVM: what a cell runs for the other cell's customers when that cell is lost (ADR-027). Its manifest is the union of the four hosts' manifests, and CI checks they agree.</description>

  <!-- THE RELEASE MANIFEST for this host: the exact service versions it ships.
       Changing a version here is a release, and goes through the pre-prod gate.
       Each version X.Y.Z is built from tag vX.Y.Z of its repository by ../install-services.sh. -->
  <properties>
    <java.version>21</java.version>
    <sprout-identity.version>0.3.0</sprout-identity.version>
    <sprout-gateway.version>0.4.2</sprout-gateway.version>
    <sprout-sandbox.version>0.2.1</sprout-sandbox.version>
    <sprout-marketdata.version>0.2.1</sprout-marketdata.version>
    <sprout-oms.version>0.5.4</sprout-oms.version>
    <sprout-plans.version>0.2.2</sprout-plans.version>
    <sprout-habits.version>0.4.0</sprout-habits.version>
    <sprout-rewards.version>0.1.0</sprout-rewards.version>
    <sprout-accounts.version>0.3.1</sprout-accounts.version>
    <sprout-payments.version>0.3.0</sprout-payments.version>
    <sprout-ledger.version>0.3.3</sprout-ledger.version>
    <sprout-settlement.version>0.2.2</sprout-settlement.version>
    <sprout-statements.version>0.2.1</sprout-statements.version>
    <sprout-recon.version>0.2.2</sprout-recon.version>
    <sprout-goals.version>0.2.0</sprout-goals.version>
    <sprout-bank.version>0.5.0</sprout-bank.version>
    <sprout-exchange.version>0.4.2</sprout-exchange.version>
    <sprout-depository.version>0.2.4</sprout-depository.version>
    <sprout-clearing.version>0.2.2</sprout-clearing.version>
  </properties>


  <dependencies>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-identity</artifactId>
      <version>${sprout-identity.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-gateway</artifactId>
      <version>${sprout-gateway.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-sandbox</artifactId>
      <version>${sprout-sandbox.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-marketdata</artifactId>
      <version>${sprout-marketdata.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-oms</artifactId>
      <version>${sprout-oms.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-plans</artifactId>
      <version>${sprout-plans.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-habits</artifactId>
      <version>${sprout-habits.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-rewards</artifactId>
      <version>${sprout-rewards.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-accounts</artifactId>
      <version>${sprout-accounts.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-payments</artifactId>
      <version>${sprout-payments.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-ledger</artifactId>
      <version>${sprout-ledger.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-settlement</artifactId>
      <version>${sprout-settlement.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-statements</artifactId>
      <version>${sprout-statements.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-recon</artifactId>
      <version>${sprout-recon.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-goals</artifactId>
      <version>${sprout-goals.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-bank</artifactId>
      <version>${sprout-bank.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-exchange</artifactId>
      <version>${sprout-exchange.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-depository</artifactId>
      <version>${sprout-depository.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-clearing</artifactId>
      <version>${sprout-clearing.version}</version>
    </dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <finalName>cell-host</finalName>
    <resources>
      <!-- the host's name, version and services, filled in from the manifest above -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes><include>sprout-host.properties</include></includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes><exclude>sprout-host.properties</exclude></excludes>
      </resource>
      <!-- the gateway's routes for this deployment, as the edge host has them -->
      <resource>
        <directory>../edge/src/main/resources</directory>
        <filtering>false</filtering>
        <includes><include>edge-gateway-routes.yml</include></includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <!-- code every host shares lives in ../common -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>common-sources</id>
            <goals><goal>add-source</goal></goals>
            <!-- and the four hosts' own start-up code, which this host runs one after another -->
            <configuration><sources><source>../common/src/main/java</source><source>../edge/src/main/java</source><source>../trading/src/main/java</source><source>../money/src/main/java</source><source>../street/src/main/java</source></sources></configuration>
          </execution>
          <execution>
            <id>common-test-sources</id>
            <goals><goal>add-test-source</goal></goals>
            <configuration><sources><source>../common/src/test/java</source></sources></configuration>
          </execution>
          <execution>
            <id>common-test-resources</id>
            <goals><goal>add-test-resource</goal></goals>
            <configuration><resources><resource><directory>../common/src/test/resources</directory></resource></resources></configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>app.sprout.hosts.cell.CellHost</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
