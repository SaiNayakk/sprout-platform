<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.12</version>
    <relativePath/>
  </parent>

  <groupId>app.sprout.hosts</groupId>
  <artifactId>trading-host</artifactId>
  <version>0.1.0</version>
  <name>trading-host</name>
  <description>One JVM for the trading services: market data now; orders and risk as they arrive.</description>

  <!-- THE RELEASE MANIFEST for this host: the exact service versions it ships.
       Changing a version here is a release, and goes through the pre-prod gate.
       Each version X.Y.Z is built from tag vX.Y.Z of its repository by ../install-services.sh. -->
  <properties>
    <java.version>21</java.version>
    <sprout-marketdata.version>0.1.0</sprout-marketdata.version>
  </properties>


  <dependencies>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-marketdata</artifactId>
      <version>${sprout-marketdata.version}</version>
    </dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <finalName>trading-host</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>app.sprout.hosts.trading.TradingHost</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
