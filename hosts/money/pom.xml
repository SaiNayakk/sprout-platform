<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.12</version>
    <relativePath/>
  </parent>

  <groupId>app.sprout.hosts</groupId>
  <artifactId>money-host</artifactId>
  <version>0.6.2</version>
  <name>money-host</name>
  <description>One JVM for the money services: accounts, payments and the ledger.</description>

  <!-- THE RELEASE MANIFEST for this host: the exact service versions it ships.
       Changing a version here is a release, and goes through the pre-prod gate.
       Each version X.Y.Z is built from tag vX.Y.Z of its repository by ../install-services.sh. -->
  <properties>
    <java.version>21</java.version>
    <sprout-accounts.version>0.3.1</sprout-accounts.version>
    <sprout-payments.version>0.3.0</sprout-payments.version>
    <sprout-ledger.version>0.3.3</sprout-ledger.version>
    <sprout-settlement.version>0.2.2</sprout-settlement.version>
    <sprout-statements.version>0.2.1</sprout-statements.version>
    <sprout-recon.version>0.2.2</sprout-recon.version>
    <sprout-goals.version>0.1.1</sprout-goals.version>
  </properties>


  <dependencies>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-accounts</artifactId>
      <version>${sprout-accounts.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-payments</artifactId>
      <version>${sprout-payments.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-ledger</artifactId>
      <version>${sprout-ledger.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-settlement</artifactId>
      <version>${sprout-settlement.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-statements</artifactId>
      <version>${sprout-statements.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-recon</artifactId>
      <version>${sprout-recon.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.SaiNayakk</groupId>
      <artifactId>sprout-goals</artifactId>
      <version>${sprout-goals.version}</version>
    </dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <finalName>money-host</finalName>
    <resources>
      <!-- the host's name, version and services, filled in from the manifest above -->
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes><include>sprout-host.properties</include></includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes><exclude>sprout-host.properties</exclude></excludes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <!-- code every host shares lives in ../common -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>common-sources</id>
            <goals><goal>add-source</goal></goals>
            <configuration><sources><source>../common/src/main/java</source></sources></configuration>
          </execution>
          <execution>
            <id>common-test-sources</id>
            <goals><goal>add-test-source</goal></goals>
            <configuration><sources><source>../common/src/test/java</source></sources></configuration>
          </execution>
          <execution>
            <id>common-test-resources</id>
            <goals><goal>add-test-resource</goal></goals>
            <configuration><resources><resource><directory>../common/src/test/resources</directory></resource></resources></configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>app.sprout.hosts.money.MoneyHost</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
