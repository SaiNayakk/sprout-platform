# The edge host as it runs on the phone: same jar, same JVM flags, same memory budget
# (set by the compose file). Built from the host jar that pins exact service versions.
FROM eclipse-temurin:21-jre-alpine

RUN addgroup -S sprout && adduser -S sprout -G sprout
WORKDIR /app
COPY hosts/edge/target/edge-host.jar /app/edge-host.jar
USER sprout

# The tuned flags measured on the phone (see docs: decisions/0003-shared-jvm-hosts).
ENV JAVA_OPTS="-XX:+UseSerialGC -Xms32m -Xmx160m -Xss512k -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=48m -XX:TieredStopAtLevel=1"

EXPOSE 8100
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/edge-host.jar"]
